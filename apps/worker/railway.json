{
  "$schema": "https://railway.com/railway.schema.json",
  "build": { "buildCommand": "pnpm -r --filter @festhub/worker... build" },
  "deploy": {
    "startCommand": "pnpm --filter @festhub/worker start",
    "numReplicas": 1,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
